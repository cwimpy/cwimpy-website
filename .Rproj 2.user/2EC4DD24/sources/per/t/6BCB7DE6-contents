library(tidyverse)

setwd("/Users/cwimpy/Documents/GitHub/posc-6013-work/Fall 2023/data")

data <- read_csv("hibbs.csv")

summary(data$growth)

model <- lm(formula = vote ~ growth, data = data)
summary(model)

modelsummary(model, statistic = 'conf.int', 
             conf_level = .95, 
             gof_omit = 'DF|Deviance|AIC|BIC|F|RMSE|Log.Lik.|R2 Adj.')|> 
  kable_styling(latex_options = "HOLD_position") 

modelsummary(model, statistic = 'conf.int', 
             conf_level = .95, 
             stars = T,
             gof_omit = 'DF|Deviance|AIC|BIC|F|RMSE|Log.Lik.|R2 Adj.') |> 
  kable_styling(latex_options = "HOLD_position") 

cm <- c('growth' = 'Growth',
        '(Intercept)' = 'Constant',
        'Num.Obs.' = "Observations")

modelsummary(model, statistic = 'conf.int', 
             conf_level = .95, 
             stars = T,
             coef_map = cm,
             gof_omit = 'DF|Deviance|AIC|BIC|F|RMSE|Log.Lik.|R2 Adj.') |> 
  kable_styling(latex_options = "HOLD_position") 

modelplot(model, coef_map = cm) 

modelplot(model, coef_map = cm) + 
  geom_vline(xintercept = 0, color = "#cc092f")
